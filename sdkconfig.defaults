# ESP32-C6 / ESP32-S3 LIN Sniffer - SDK Configuration Defaults

# Compiler optimizations
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Note: ASSERTIONS is a choice - set via menuconfig if needed

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Log output
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL=4

# Serial flasher config
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition table: two OTA slots + NVS (required for OTA updates)
CONFIG_PARTITION_TABLE_TWO_OTA=y

# CPU frequency: set via menuconfig → Component config → ESP System Settings
# (symbol name is chip-specific, cannot be set here reliably)

# LIN Sniffer Application Configuration
CONFIG_WIFI_SSID=""
CONFIG_WIFI_PASSWORD=""
CONFIG_WIFI_MAXIMUM_RETRY=5

CONFIG_LIN_UART_NUM=1
CONFIG_LIN_UART_RX_GPIO=4
CONFIG_LIN_UART_TX_GPIO=5
CONFIG_LIN_BAUDRATE=9600
CONFIG_LIN_BYTE_TIMEOUT_MS=50

CONFIG_TCP_PORT=23
CONFIG_MAX_TCP_CLIENTS=3

# ESP32 Configuration
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LWIP
CONFIG_LWIP_SO_RCVBUF=y
